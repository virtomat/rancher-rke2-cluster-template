{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Legacy direct-Helm fallback used unchanged only when cluster.userName is empty."
        },
        "userName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "description": "Lower-case DNS label (no dots, uppercase, or whitespace) used as <environment>-<userName> when non-empty. The derived name must not exceed 63 characters."
        },
        "environment": {
          "type": "string",
          "enum": [
            "stg",
            "prod"
          ],
          "default": "stg",
          "description": "Environment prefix for cluster.userName."
        },
        "config": {
          "type": "object",
          "properties": {
            "kubernetesVersion": {
              "type": "string",
              "enum": [
                "v1.33.13+rke2r2",
                "v1.34.12+rke2r1",
                "v1.35.9+rke2r1"
              ]
            }
          }
        }
      }
    }
  }
}
